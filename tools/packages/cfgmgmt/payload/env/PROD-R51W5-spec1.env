# LL128 采纳三键（2026-10-09 LL128-ADOPT 窗；F7 P0-C 测试态指纹逐字：BUFFSIZE 8MiB→1MiB+LL128_BUFFSIZE 262144+PROTO ^LL128；覆盖 COMMON_ENV 缺省靠 docker -e last-wins——注入块 :249 在 COMMON_ENV 后追加）
NCCL_BUFFSIZE=1048576
NCCL_LL128_BUFFSIZE=262144
NCCL_PROTO=^LL128

# WOPTA-L2PF45（W-OPTA-CLOSELINE S3 臂=43 键产线基座逐字+l2pf 6MB 单键域 2 env 键；键面逐字取自 dev/f6prime/arms/F6P-L2PF-6MB-spec1.env 尾两行=F6'/F7' 两窗绿侧形；法源=W-OPTA-CLOSELINE-WINCARD S3+REG-2 放宽重裁）
