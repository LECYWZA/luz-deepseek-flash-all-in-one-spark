# gateway.env.template — concurrency-proxy-v2 配置模板（**密钥值绝不入包**）
# 落位：宿主 0600（/opt/aicad-prod/secrets/gateway.env；01 现役值面见 GATEWAY-MIGRATION §〇）
# 用法：部署窗按机填值；GW_API_KEY 值=密钥串，禁入 git/日志/镜像（SMOK_KEY 前科律）。
# 部署序（GW-INFRAS-AUDIT-20261014 A7）：本件先填值落位→gw-verify --offline 验绿
# →再落 unit（EnvironmentFile 无 `-` 容缺前缀=env 缺即启动快败，防裸默认值误指 8002）。
UPSTREAM=http://127.0.0.1:8899
PORT=8001
MAX_CONCURRENCY=16
# 准入等待（A3，对齐在役 zz-queue-timeout.conf drop-in 值 5；缺键→脚本默认 20=语义漂移）
QUEUE_TIMEOUT=5
# 长流参数（A1：CHUNK_IDLE_TIMEOUT 显式钉 600=rc3.8 O-2 实证值——注释写值却缺键的错配闭合；
#   01 在役主 unit 现值 180=rc3.8 已修病值，其改值+restart=重启窗承载，与 A10 同窗）
CHUNK_IDLE_TIMEOUT=600
# A2：思考链源头开关（rc3.6 注入；缺键→默认 0=按包部署即静默关思考链=行为反转）。
#   8001 在役形=1（inject.conf）；VL 车道=0（见 gateway-vl.env.template，呈裁 C3）。
INJECT_ENABLE_THINKING=1
WRITE_TIMEOUT=60
TOTAL_STREAM_TIMEOUT=7200
DEDUP_ENABLE=1
GW_API_KEY=<值位空——部署窗填入，绝不入包>
