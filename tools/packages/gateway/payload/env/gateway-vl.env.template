# gateway-vl.env.template — concurrency-proxy-v2 VL 车道配置模板（**密钥值绝不入包**）
# VL-NATIVE-WINCARD-20261013 §4.3：落位宿主 0600（/opt/aicad-prod/secrets/gateway-vl.env）。
# 车道制分流：客户端按端口选车道（8001=文本车道现役不动；8002=VL 车道本件）。
# UPSTREAM（A9，转正态注记）：=8899（VL-PROMO-20261013 S2 单行改+restart 在案，2026-10-13）；
#   认证期 8898=历史测试靴**已拆线**——照抄旧值=指回死端口。
# 部署序（GW-INFRAS-AUDIT-20261014 A7）：本件先填值落位→gw-verify --offline <主 env> <本件>
#   验绿→再落 unit（EnvironmentFile 无 `-` 容缺前缀=env 缺即启动快败）。
UPSTREAM=http://127.0.0.1:8899
PORT=8002
# 图像 prefill 重，车道并发减半（R4 规避=DEDUP_ENABLE=0：图像大 body 前缀哈希伪碰撞面；
#   rc3.8.3-B1 全量哈希治本后 DEDUP=1 可安全复开本车道=呈裁 C2/C3 位）
MAX_CONCURRENCY=8
# A2：VL 车道显式钉 0（=脚本默认与在役实值同面，零行为变化；是否对齐 8001=1 呈裁 C3）
INJECT_ENABLE_THINKING=0
WRITE_TIMEOUT=60
TOTAL_STREAM_TIMEOUT=7200
DEDUP_ENABLE=0
# rc3.8.6 容量广播两键（缺省关——VL 车道留档面；语义与主模板同，8002 已撤除=回退面）
ADVERTISE_MODEL_CAPACITY=0
MODELS_CONTEXT_LEN=0
GW_API_KEY=<值位空——部署窗填入，绝不入包>
