# gateway-vl.env.template — concurrency-proxy-v2 VL 车道配置模板（**密钥值绝不入包**）
# VL-NATIVE-WINCARD-20261013 §4.3：落位宿主 0600（/opt/aicad-prod/secrets/gateway-vl.env）。
# 车道制分流：客户端按端口选车道（8001=文本车道现役不动；8002=VL 车道本件）。
# UPSTREAM：认证期=8898（VL 测试靴）；**S4 阶梯全绿+主会话呈裁后切 8899**（转正态）。
UPSTREAM=http://127.0.0.1:8898
PORT=8002
# 图像 prefill 重，车道并发减半（R4 规避=DEDUP_ENABLE=0：图像大 body 前缀哈希伪碰撞面）
MAX_CONCURRENCY=8
WRITE_TIMEOUT=60
TOTAL_STREAM_TIMEOUT=7200
DEDUP_ENABLE=0
GW_API_KEY=<值位空——部署窗填入，绝不入包>
